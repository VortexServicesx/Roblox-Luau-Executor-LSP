    "parameters": [
        {
            "name": "target",
            "type": "function | number",
            "description": "Lua function or stack level whose upvalue is modified."
        },
        {
            "name": "index",
            "type": "number",
            "description": "One-based upvalue index."
        },
        {
            "name": "value",
            "type": "any",
            "description": "New value for the upvalue."
        }
    ],
    "returns": "()"
}