{
    "name": "json.encode",
    "type": "function",
    "description": "Serializes a Lua value to a JSON string. json.stringify is registered to the same function.",
    "parameters": [
        {
            "name": "value",
            "type": "any",
            "description": "Value to encode."
        },
        {
            "name": "options",
            "type": "EncodeOptions?",
            "description": "Optional encoding and formatting options."
        }
    ],
    "returns": "string"
}