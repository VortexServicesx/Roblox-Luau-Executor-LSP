{
    "name": "json.tryDecode",
    "type": "function",
    "description": "Attempts to parse a JSON string like json.decodeSafe and returns status values for parse errors.",
    "parameters": [
        {
            "name": "json",
            "type": "string",
            "description": "JSON string to parse."
        },
        {
            "name": "options",
            "type": "DecodeOptions?",
            "description": "Optional decode options."
        }
    ],
    "returns": [
        "boolean",
        "any | nil",
        "string | nil",
        "number | nil"
    ]
}